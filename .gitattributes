# The Wizz hydration walk compares template whitespace byte-for-byte with
# the browser-parsed DOM, which normalizes CRLF to LF: keep sources LF.
*.wizz text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
# The Dockerfile and shell scripts run on Linux: keep them LF so a Windows
# checkout with core.autocrlf=true cannot leave a CRLF copy that blocks
# switching branches.
Dockerfile text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
