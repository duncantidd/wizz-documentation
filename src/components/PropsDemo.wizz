<script>
  import Meter from "./Meter.wizz";

  let level = 40;
  let label = "CPU budget";
  let updates = 0;

  // The bindings own level and label; this only counts the edits.
  function countUpdate() {
    updates += 1;
  }
</script>

<div class="props-demo">
  <p class="note">Parent → child prop updates: <strong>{updates}</strong> · the child is never remounted.</p>
  <div class="controls">
    <label class="field">
      <span>value prop</span>
      <input type="range" min="0" max="100" bind:value={level} on:input={countUpdate} />
    </label>
    <label class="field">
      <span>label prop</span>
      <input type="text" bind:value={label} on:input={countUpdate} />
    </label>
  </div>
  <div class="child">
    <Meter
      label={label}
      value={level}
      barStyle={"transform: scaleX(" + level / 100 + ")"}
      meterClass={level > 80 ? "meter hot" : level > 55 ? "meter warm" : "meter calm"}
    />
  </div>
</div>

<wizz:style>
  .props-demo {
    display: grid;
    gap: 1.1rem;
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  input {
    font: inherit;
  }

  .field input[type="text"] {
    min-block-size: 2.5rem;
    padding-inline: 0.85rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--hairline);
    background-color: var(--well);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .field input[type="range"] {
    accent-color: var(--accent);
    min-block-size: 2.5rem;
  }

  .child {
    padding: 1rem;
    border-radius: var(--r-md);
    border: 1px solid var(--hairline);
    background-color: var(--hover-fill);
  }

  .note {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.85rem;
  }

  .note strong {
    color: var(--ink);
    font-family: var(--font-mono);
  }
</wizz:style>
