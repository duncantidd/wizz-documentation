<script>
  export let label = "Live counter";

  // Survives reloads and stays in sync across every open tab.
  let count = persist("wizz_docs_counter", 0);

  let doubled = 0;
  let parity = "even";
  let bump = "value";
  let flip = false;

  function derive() {
    doubled = count * 2;
    parity = count % 2 === 0 ? "even" : "odd";
    // Alternate between two identical keyframes so every change replays.
    flip = !flip;
    bump = flip ? "value bump-a" : "value bump-b";
  }

  function increment() {
    count += 1;
    derive();
  }

  function decrement() {
    count -= 1;
    derive();
  }

  function reset() {
    count = 0;
    derive();
  }

  onMount(() => {
    doubled = count * 2;
    parity = count % 2 === 0 ? "even" : "odd";
  });
</script>

<div class="counter">
  <p class="label"><span class="live" aria-hidden="true"></span>{label}</p>
  <output class={bump} aria-live="polite">{count}</output>
  <p class="meta">doubled <strong>{doubled}</strong> · parity <strong>{parity}</strong></p>
  <div class="controls">
    <button type="button" class="step" on:click={decrement} aria-label="Decrement">−</button>
    <button type="button" class="step primary" on:click={increment} aria-label="Increment">+</button>
    <button type="button" class="reset" on:click={reset}>Reset</button>
  </div>
</div>

<wizz:style>
  .counter {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--ink-3);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .live {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background-color: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }

  .value {
    display: block;
    min-inline-size: 4ch;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2.5rem + 4vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--cyan), var(--accent) 55%, var(--amber));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bump-a { animation: bump-a 380ms var(--ease-spring); }
  .bump-b { animation: bump-b 380ms var(--ease-spring); }

  @keyframes bump-a {
    from { transform: scale(0.82) translateY(4px); filter: blur(2px); }
    to { transform: scale(1); filter: blur(0); }
  }

  @keyframes bump-b {
    from { transform: scale(0.82) translateY(4px); filter: blur(2px); }
    to { transform: scale(1); filter: blur(0); }
  }

  .meta {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .meta strong {
    color: var(--ink);
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    margin-block-start: 0.4rem;
  }

  button {
    min-block-size: 2.75rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--hairline);
    background-color: var(--hover-fill);
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
    box-shadow: inset 0 1px 0 var(--glint);
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }

  button:hover {
    border-color: color-mix(in oklch, var(--accent) 50%, transparent);
  }

  button:active {
    transform: scale(0.92);
  }

  .step {
    inline-size: 2.75rem;
    font-size: 1.3rem;
  }

  .primary {
    border-color: transparent;
    color: oklch(0.16 0.03 270);
    background: linear-gradient(135deg, oklch(0.88 0.12 210), oklch(0.8 0.14 292));
  }

  .reset {
    padding-inline: 1.1rem;
    font-size: 0.85rem;
  }
</wizz:style>
