<script>
  export let code = "";
  export let lang = "wizz";
  export let title = "";

  // A tiny zero-dependency highlighter. Tokens are computed once from the
  // props and rendered with {#each}; a const collection renders at mount and
  // stays out of the serialized hydration state.
  const KEYWORDS = new Set([
    "let", "const", "var", "function", "return", "if", "else", "export", "import",
    "from", "default", "async", "await", "new", "for", "of", "in", "true", "false",
    "null", "undefined", "typeof", "this", "class", "try", "catch", "throw", "while"
  ]);

  const RULES = [
    [/^\/\/[^\n]*/, "com"],
    [/^\/\*[\s\S]*?\*\//, "com"],
    [/^<!--[\s\S]*?-->/, "com"],
    [/^(?:"(?:[^"\\\n]|\\.)*"|'(?:[^'\\\n]|\\.)*'|`(?:[^`\\]|\\.)*`)/, "str"],
    [/^\{[#:/][a-z]+/, "dir"],
    [/^on:[a-z]+/, "dir"],
    [/^<\/?[A-Za-z][\w:.-]*/, "tag"],
    [/^\/?>/, "tag"],
    [/^-?\d+(?:\.\d+)?\b/, "num"]
  ];

  // Note: helpers below avoid nested `let` — the compiler's state scanner
  // treats every `let` in the script as component state, even inside
  // functions, so local bindings are const and the cursor is an object.
  function wordKind(text, next, after, language) {
    if (KEYWORDS.has(text)) return "kw";
    if (next === "=" && after !== "=") return language === "bash" ? "plain" : "attr";
    if (next === "(") return "fn";
    if (language === "json" && next === ":") return "attr";
    return "plain";
  }

  function matchAt(rest, language, atBoundary) {
    if (language === "bash") {
      // Shell: # opens a comment after whitespace, and // is part of URLs.
      const comment = /^#[^\n]*/.exec(rest);
      const flag = /^--?[a-zA-Z][\w-]*/.exec(rest);
      const quoted = /^(?:"(?:[^"\\\n]|\\.)*"|'[^'\n]*')/.exec(rest);
      const word = /^[^\s"'#]+/.exec(rest);
      if (comment && atBoundary) return [comment[0], "com"];
      if (flag && atBoundary) return [flag[0], "attr"];
      if (quoted) return [quoted[0], "str"];
      if (/^wizz\b/.test(rest) && atBoundary) return ["wizz", "fn"];
      if (word) return [word[0], "plain"];
    }

    if (language !== "text" && language !== "bash") {
      for (const [pattern, kind] of RULES) {
        const hit = pattern.exec(rest);
        if (hit) return [hit[0], kind];
      }

      const word = /^[A-Za-z_$][\w$-]*/.exec(rest);
      if (word) {
        const text = word[0];
        return [text, wordKind(text, rest.charAt(text.length), rest.charAt(text.length + 1), language)];
      }
    }

    const ch = rest.charAt(0);
    return [ch, /[{}()[\];,.=+\-*/<>!?:&|]/.test(ch) ? "pun" : "plain"];
  }

  function tokenize(source, language) {
    const out = [];
    const cursor = { pos: 0 };

    while (cursor.pos < source.length) {
      const rest = source.slice(cursor.pos);
      const last = out[out.length - 1];
      const atBoundary = !last || /\s$/.test(last.text);
      const [text, kind] = matchAt(rest, language, atBoundary);

      if (last && last.kind === kind) {
        last.text += text;
      } else {
        out.push({ text, kind });
      }
      cursor.pos += text.length;
    }

    return out.map((token) => ({ text: token.text, kind: "t-" + token.kind }));
  }

  // The compiler re-indents copied script lines, which shifts every line of
  // a multi-line string literal after the first. Samples are authored with
  // at least one flush-left line, so stripping the common indent of lines
  // 2..n restores them exactly (and identically on server and client).
  function dedent(text) {
    const lines = text.replace(/\n+$/, "").split("\n");
    const indents = lines
      .slice(1)
      .filter((line) => line.trim() !== "")
      .map((line) => line.length - line.trimStart().length);
    const cut = indents.length > 0 ? Math.min(...indents) : 0;
    return [lines[0], ...lines.slice(1).map((line) => line.slice(Math.min(cut, line.length - line.trimStart().length)))].join("\n");
  }

  const source = dedent(code);
  const tokens = tokenize(source, lang);
  const label = title === "" ? lang : title;

  let copyLabel = "Copy";
  let copyIcon = "icon icon-copy";
  let stateClass = "code well";
  let resetTimer = null;

  async function copyCode() {
    // Resolve to a boolean instead of try/catch: the assignment rewriter does
    // not track mutations after an optional-binding `catch {` block.
    const copied = await navigator.clipboard.writeText(source).then(() => true, () => false);
    copyLabel = copied ? "Copied" : "Press Ctrl+C";
    copyIcon = "icon icon-check";
    stateClass = "code well is-copied";
    clearTimeout(resetTimer);
    resetTimer = setTimeout(() => {
      copyLabel = "Copy";
      copyIcon = "icon icon-copy";
      stateClass = "code well";
    }, 1800);
  }

  onDestroy(() => {
    clearTimeout(resetTimer);
  });
</script>

<figure class={stateClass}>
  <figcaption class="bar">
    <span class="dots" aria-hidden="true"></span>
    <span class="title">{label}</span>
    <button type="button" class="copy" on:click={copyCode} aria-live="polite">
      <span class={copyIcon} aria-hidden="true"></span>
      <span class="copy-label">{copyLabel}</span>
    </button>
  </figcaption>
  <pre tabindex="0"><code>{#each tokens as token}<span class={token.kind}>{token.text}</span>{/each}</code></pre>
</figure>

<wizz:style>
  .code {
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-md);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.5rem 0.45rem 0.95rem;
    border-block-end: 1px solid var(--well-border);
    background-color: var(--hover-fill);
    font-size: 0.78rem;
  }

  .dots {
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border-radius: 50%;
    background-color: oklch(0.72 0.17 25);
    box-shadow:
      0.9rem 0 0 oklch(0.82 0.15 85),
      1.8rem 0 0 oklch(0.76 0.16 150);
    margin-inline-end: 1.9rem;
    opacity: 0.85;
  }

  .title {
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-block-size: 2rem;
    padding-inline: 0.7rem;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--ink-3);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .copy:hover {
    color: var(--ink);
    background-color: var(--hover-fill);
    border-color: var(--hairline);
  }

  .copy:active {
    transform: scale(0.94);
  }

  .is-copied .copy {
    color: var(--mint);
    border-color: color-mix(in oklch, var(--mint) 45%, transparent);
    background-color: color-mix(in oklch, var(--mint) 14%, transparent);
  }

  .is-copied .icon {
    animation: pop 420ms var(--ease-spring) both;
  }

  .is-copied .copy-label {
    animation: slide-in 320ms var(--ease-out) both;
  }

  @keyframes pop {
    from { transform: scale(0.3) rotate(-25deg); opacity: 0; }
    to { transform: scale(1) rotate(0); opacity: 1; }
  }

  @keyframes slide-in {
    from { transform: translateY(6px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  pre {
    margin: 0;
    padding: 1rem 1.15rem 1.1rem;
    overflow-x: auto;
    color: var(--code-ink);
    font-size: 0.86rem;
    line-height: 1.7;
    tab-size: 2;
    scrollbar-width: thin;
  }

  code {
    font-family: var(--font-mono);
    font-weight: 450;
  }

  .t-kw { color: var(--tok-kw); font-weight: 550; }
  .t-str { color: var(--tok-str); }
  .t-num { color: var(--tok-num); }
  .t-com { color: var(--tok-com); font-style: italic; }
  .t-tag { color: var(--tok-tag); }
  .t-attr { color: var(--tok-attr); }
  .t-dir { color: var(--tok-dir); font-weight: 550; }
  .t-fn { color: var(--tok-fn); }
  .t-pun { color: var(--tok-pun); }
</wizz:style>
