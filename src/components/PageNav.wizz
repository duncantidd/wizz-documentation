<script>
  export let prevHref = "";
  export let prevLabel = "";
  export let nextHref = "";
  export let nextLabel = "";

  // Both cards always render (a dynamic href inside an untaken {#if} branch
  // would have no node to update); a missing neighbour is hidden instead.
  const prevClass = prevHref === "" ? "card prev is-empty" : "card prev";
  const nextClass = nextHref === "" ? "card next is-empty" : "card next";
</script>

<nav class="pager" aria-label="Pagination">
  <a class={prevClass} href={prevHref}><span class="dir"><span class="icon icon-arrow-left" aria-hidden="true"></span>Previous</span><span class="name">{prevLabel}</span></a>
  <a class={nextClass} href={nextHref}><span class="dir">Next<span class="icon icon-arrow" aria-hidden="true"></span></span><span class="name">{nextLabel}</span></a>
</nav>

<wizz:style>
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-inline-size: var(--content-max);
    margin: 3.5rem auto 0;
  }

  .card {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.2rem;
    border-radius: var(--r-md);
    border: 1px solid var(--hairline);
    background-color: var(--hover-fill);
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 0 1px 0 var(--glint);
    transition: transform var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }

  .card:hover {
    color: var(--ink);
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--accent) 50%, transparent);
    background-color: var(--active-fill);
  }

  .next {
    grid-column: 2;
    text-align: end;
  }

  .is-empty {
    visibility: hidden;
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-3);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .next .dir {
    justify-content: flex-end;
  }

  .icon {
    transition: transform var(--dur) var(--ease-out);
  }

  .prev:hover .icon {
    transform: translateX(-3px);
  }

  .next:hover .icon {
    transform: translateX(3px);
  }

  .name {
    font-size: 1.05rem;
    font-weight: 700;
  }

  @media (max-width: 36rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .next {
      grid-column: auto;
    }

    .is-empty {
      display: none;
    }
  }
</wizz:style>
