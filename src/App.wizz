<script>
  import TopNav from "./components/TopNav.wizz";
  import CodeBlock from "./components/CodeBlock.wizz";

  const installSnippet = `curl -fsSL https://raw.githubusercontent.com/duncantidd/wizz.js/main/scripts/install-cli.sh | bash
wizz init my-app
cd my-app && wizz dev   # http://127.0.0.1:3000`;

  const features = [
    {
      id: "deps",
      icon: "icon icon-bolt",
      title: "Zero runtime dependencies",
      body: "No npm graph, no Virtual DOM, no hydration framework. The browser receives compiled ES modules and a ~150-line router."
    },
    {
      id: "compiled",
      icon: "icon icon-doc",
      title: "Compiled, not interpreted",
      body: "Each .wizz file compiles ahead of time to createElement, textContent, and keyed list updates — only the nodes that depend on changed state are touched."
    },
    {
      id: "ssr",
      icon: "icon icon-arrow",
      title: "SSR + hydration by default",
      body: "Pages render on the server and adopt their markup in place. A mismatch falls back to a clean client render — never duplicate DOM."
    },
    {
      id: "persist",
      icon: "icon icon-check",
      title: "persist() cross-tab state",
      body: "Swap a let initializer for persist(key, default) and the value survives reloads and converges across tabs over BroadcastChannel."
    },
    {
      id: "styles",
      icon: "icon icon-hash",
      title: "Scoped styles, extracted",
      body: "<wizz:style> is scoped by a data-wizz-s attribute and extracted into app.css at build time — first paint arrives styled."
    },
    {
      id: "agents",
      icon: "icon icon-search",
      title: "Built for agents too",
      body: "Stable WIZZ-P/G diagnostic codes, a JSON build envelope, and an MCP server with compile-gated writes."
    }
  ];

  const steps = [
    { id: "s1", n: "01", title: "Parse", body: "Tokenize the template, extract <script>, <wizz:head>, <wizz:style>, imports, props, persist markers." },
    { id: "s2", n: "02", title: "Analyze", body: "Map every template expression to the reactive names it reads and assign stable node IDs." },
    { id: "s3", n: "03", title: "Generate", body: "Emit a client module, a DOM-free server module, and a hydratable build with scoped CSS." },
    { id: "s4", n: "04", title: "Serve", body: "wizz dev server-renders each route; the router adopts the markup and wires listeners." }
  ];

  const tiles = [
    { id: "t1", href: "/docs/getting-started", kicker: "Start", title: "Installation & Setup", body: "Install the CLI, scaffold, and run the dev server." },
    { id: "t2", href: "/docs/components", kicker: "Learn", title: "Components & Templating", body: "Single-root templates, props, head, scoped styles." },
    { id: "t3", href: "/docs/reactivity", kicker: "Learn", title: "State & Reactivity", body: "let state, batching, events, lists, persist()." },
    { id: "t4", href: "/docs/api", kicker: "Reference", title: "API Reference", body: "Every hook, directive, module export, and compiler entry." },
    { id: "t5", href: "/docs/cli", kicker: "Tooling", title: "CLI", body: "init, dev, build, --json, --adapter node, update." },
    { id: "t6", href: "/docs/mcp", kicker: "Tooling", title: "MCP Server", body: "Six tools for agents, with a fixed root and gated writes." }
  ];

  // Cards stay visible in the server-rendered markup; once hydrated, the
  // page arms the fly-in so content never depends on JavaScript to show.
  let revealState = "off";
  let flyObserver = null;

  function handleFly(entries) {
    const entering = entries
      .filter((entry) => entry.isIntersecting)
      .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left);
    entering.forEach((entry, index) => {
      entry.target.style.setProperty("--i", index);
      entry.target.classList.add("is-in");
    });
    // Re-arm only cards that dropped below the viewport, so scrolling back
    // down replays the fly-in while cards scrolled past stay put.
    for (const entry of entries) {
      if (!entry.isIntersecting && entry.boundingClientRect.top > 0) entry.target.classList.remove("is-in");
    }
  }

  onMount(() => {
    if (!("IntersectionObserver" in window)) return;
    flyObserver = new IntersectionObserver(handleFly, { rootMargin: "0px 0px -8% 0px", threshold: 0.15 });
    for (const card of document.querySelectorAll(".landing .fly")) flyObserver.observe(card);
    revealState = "armed";
  });

  onDestroy(() => {
    flyObserver?.disconnect();
  });

  function trackSheen(event) {
    const card = event.target.closest(".sheen");
    if (!card) return;
    const rect = card.getBoundingClientRect();
    card.style.setProperty("--mx", event.clientX - rect.left + "px");
    card.style.setProperty("--my", event.clientY - rect.top + "px");
  }
</script>

<wizz:head>
  <title>Wizz.js — the zero-dependency JavaScript framework</title>
  <meta name="description" content="Wizz.js is a zero-dependency JavaScript framework. Single-file .wizz components compile to plain DOM code, with server rendering, scoped styles, and API routes built in.">
</wizz:head>

<div class="site landing" data-reveal={revealState}>
  <TopNav section="home" />

  <main id="main" class="page" on:pointermove={trackSheen}>
    <section class="hero" aria-labelledby="hero-title">
      <div class="copy">
        <h1 id="hero-title" class="rise title" style="--i: 0">The JavaScript framework with <span class="shine">zero dependencies.</span></h1>
        <p class="rise lede" style="--i: 1">Wizz.js is a full-stack framework for building web apps. Write components in single <code>.wizz</code> files and the compiler turns them into plain JavaScript that updates the DOM directly. Server rendering, scoped styles, and API routes are built in — no Virtual DOM, no npm packages to ship. This site runs on it.</p>
        <div class="rise cta" style="--i: 2">
          <a class="btn btn-primary btn-hero" href="/docs/getting-started">Get started <span class="icon icon-arrow" aria-hidden="true"></span></a>
          <a class="btn btn-hero" href="/docs/architecture">How it works</a>
        </div>
        <div class="rise install" style="--i: 3">
          <CodeBlock code={installSnippet} lang="bash" title="terminal" />
        </div>
      </div>

    </section>

    <section class="band" aria-labelledby="features-title">
      <header class="band-head">
        <p class="eyebrow">Why Wizz</p>
        <h2 id="features-title">Less runtime. More platform.</h2>
      </header>
      <div class="features">{#each features as feature (feature.id)}<article class="feature glass sheen fly"><span class="f-icon"><span class={feature.icon} aria-hidden="true"></span></span><h3>{feature.title}</h3><p>{feature.body}</p></article>{/each}</div>
    </section>

    <section class="band" aria-labelledby="pipeline-title">
      <header class="band-head">
        <p class="eyebrow">Under the hood</p>
        <h2 id="pipeline-title">From <code>.wizz</code> to pixels in four stages</h2>
      </header>
      <ol class="pipeline">{#each steps as step (step.id)}<li class="step glass fly"><span class="n">{step.n}</span><h3>{step.title}</h3><p>{step.body}</p></li>{/each}</ol>
    </section>

    <section class="band" aria-labelledby="docs-title">
      <header class="band-head">
        <p class="eyebrow">Documentation</p>
        <h2 id="docs-title">Everything, in depth</h2>
      </header>
      <div class="tiles">{#each tiles as tile (tile.id)}<a class="tile glass sheen fly" href={tile.href}><span class="t-kicker">{tile.kicker}</span><span class="t-title">{tile.title}</span><span class="t-body">{tile.body}</span><span class="t-go icon icon-arrow" aria-hidden="true"></span></a>{/each}</div>
    </section>

    <footer class="foot">
      <p>Built with Wizz.js and nothing else · MIT licensed · <a href="https://github.com/duncantidd/wizz.js">github.com/duncantidd/wizz.js</a></p>
    </footer>
  </main>
</div>

<wizz:style>
  .page {
    inline-size: 100%;
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
    view-transition-name: doc-main;
  }

  .hero {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
  }

  .copy {
    max-inline-size: 72rem;
    margin-inline: auto;
  }

  .title {
    margin: 0;
    font-size: clamp(2.8rem, 1.4rem + 5vw, 6rem);
    font-weight: 850;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
    text-shadow: var(--ink-shadow);
  }

  .shine {
    background: linear-gradient(100deg, var(--cyan), var(--accent) 45%, var(--amber) 80%, var(--cyan));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    animation: shine 9s linear infinite;
  }

  @keyframes shine {
    to { background-position: -200% 0; }
  }

  .lede {
    max-inline-size: 50rem;
    margin: 1.5rem auto 0;
    color: var(--ink-2);
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.3rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .lede code {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background-color: var(--well);
    color: var(--ink);
    font-size: 0.9em;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-block-start: 2.5rem;
  }

  .btn-hero {
    min-block-size: 3.5rem;
    padding-inline: 2rem;
    font-size: 1.1rem;
  }

  .btn-primary.btn-hero {
    padding-inline: 2.5rem;
    font-weight: 700;
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--accent) 30%, transparent),
      0 18px 50px -12px color-mix(in oklch, var(--accent) 90%, transparent),
      inset 0 1px 0 oklch(1 0 0 / 0.6);
  }

  .btn-primary.btn-hero:hover {
    transform: translateY(-2px);
  }

  .btn-primary.btn-hero .icon {
    transition: transform var(--dur) var(--ease-out);
  }

  .btn-primary.btn-hero:hover .icon {
    transform: translateX(3px);
  }

  .install {
    max-inline-size: 60rem;
    margin: 2.5rem auto 0;
    text-align: start;
  }

  .band {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .band-head {
    max-inline-size: 40rem;
    margin-block-end: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  h2 code {
    font-size: 0.85em;
    color: var(--accent);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .feature {
    padding: 1.5rem;
  }

  .f-icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: var(--r-sm);
    border: 1px solid color-mix(in oklch, var(--accent) 35%, transparent);
    background: linear-gradient(135deg, color-mix(in oklch, var(--cyan) 22%, transparent), color-mix(in oklch, var(--accent) 22%, transparent));
    color: var(--ink);
    font-size: 1.15rem;
    box-shadow: inset 0 1px 0 var(--glint);
  }

  .feature h3 {
    margin: 1rem 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .feature p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .step {
    position: relative;
    padding: 1.5rem;
  }

  .n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
  }

  .step h3 {
    margin: 0.5rem 0 0.35rem;
    font-size: 1.2rem;
  }

  .step p {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.93rem;
    line-height: 1.6;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .tile {
    display: grid;
    gap: 0.3rem;
    padding: 1.4rem 3.25rem 1.4rem 1.4rem;
    color: var(--ink);
    text-decoration: none;
  }

  .tile:hover {
    color: var(--ink);
  }

  .t-kicker {
    color: var(--ink-3);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .t-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .t-body {
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .t-go {
    position: absolute;
    inset-block-start: 1.4rem;
    inset-inline-end: 1.4rem;
    color: var(--accent);
    transition: transform var(--dur) var(--ease-out);
  }

  .tile:hover .t-go {
    transform: translateX(4px);
  }

  /* Card fly-in + hover lift. The entrance uses the individual translate and
     scale properties so it never fights the hover's transform. Transitions
     live only on .is-in, so re-arming a card hides it instantly. */
  .fly {
    transition: transform var(--dur) var(--ease-out);
  }

  @media (hover: hover) {
    .fly:hover {
      transform: translateY(-5px);
    }
  }

  [data-reveal="armed"] .fly:not(.is-in) {
    opacity: 0;
    translate: 0 3rem;
    scale: 0.94;
  }

  [data-reveal="armed"] .fly.is-in {
    --delay: calc(var(--i, 0) * var(--stagger) * 1.4);
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur-slow) var(--ease-out) var(--delay),
      translate 900ms var(--ease-spring) var(--delay),
      scale 900ms var(--ease-spring) var(--delay);
  }

  .foot {
    padding-block: 2rem 3rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--ink-3);
    font-size: 0.88rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .shine {
      animation: none;
    }

    /* Fade only: no travel, no lift. */
    [data-reveal="armed"] .fly:not(.is-in) {
      translate: none;
      scale: none;
    }

    .fly:hover {
      transform: none;
    }
  }
</wizz:style>
