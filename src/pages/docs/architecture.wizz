<script>
  import TopNav from "../../components/TopNav.wizz";
  import Sidebar from "../../components/Sidebar.wizz";
  import Toc from "../../components/Toc.wizz";
  import CodeBlock from "../../components/CodeBlock.wizz";
  import Callout from "../../components/Callout.wizz";
  import PageNav from "../../components/PageNav.wizz";

  const toc = [
    { id: "philosophy", label: "Philosophy" },
    { id: "zero-deps", label: "Why zero dependencies", depth: 3 },
    { id: "no-vdom", label: "Why no Virtual DOM", depth: 3 },
    { id: "pipeline", label: "The compiler pipeline" },
    { id: "compiled-output", label: "What the compiler emits" },
    { id: "update-model", label: "The update model" },
    { id: "ssr-hydration", label: "SSR & hydration" },
    { id: "styles", label: "Scoped CSS delivery" },
    { id: "versioning", label: "Versioning contract" },
    { id: "security", label: "Security boundaries" }
  ];

  const pipelineText = `Wizz component source
  -> parseComponent(source)      tokenize, extract <script>/<wizz:head>/<wizz:style>,
                                 imports, export let props, persist() markers
  -> analyzeDependencies(payload) map each expression to the reactive names it reads
  -> assignNodeIds(payload)       stable data-wizz-id for every dynamic node
  -> generateComponent(payload)       client module  (mountComponent)
     generateServerComponent(payload) server module  (renderComponent)
     generateHydrationFunction(...)   hydratable build (hydrateComponent / hydrateRoot)
  -> { source, payload, sourceMap, version }`;

  const counterSource = `<script>
  let count = 0;

  function increment() {
    count += 1;
  }
<\/script>

<main>
  <button on:click={increment}>Clicks: {count}</button>
</main>`;

  const emittedSketch = `// Generated by Wizz 1.17.1 (component syntax 1.4.2, generated output 1.8.3).
export default function mountComponent(target, props = {}) {
  let count = 0;
  function increment() {
    count += 1;
    schedule({ count: true });          // inserted by the assignment interceptor
  }

  // create(): plain DOM construction, no templates parsed at runtime
  const main = document.createElement("main");
  const button = document.createElement("button");
  button.setAttribute("data-wizz-id", "1");
  button.addEventListener("click", increment);
  // ...

  function update(changed) {
    if (changed.count) {
      textNode.data = String(count);    // only the node that reads count
    }
  }

  target.appendChild(main);
  return { destroy() { /* hooks, children, listeners, root */ } };
}`;

  const ssrRecipe = `import { renderComponent, serializeInitialState } from "./dist/pages/Home.server.js";

const { html, head, state } = renderComponent({});
const stateScript = serializeInitialState(state);
// '<script type="application/wizz-state">{"count":0}<\/script>'

// Deliver html INSIDE the mount point and the state script as its SIBLING:
const body = '<div id="app">' + html + "</div>" + stateScript;`;

  const versionLine = `// Generated by Wizz 1.17.1 (component syntax 1.4.2, generated output 1.8.3). Edits will be overwritten.`;
</script>

<wizz:head>
  <title>Architecture & Philosophy — Wizz.js Docs</title>
  <meta name="description" content="Why Wizz.js has zero dependencies and no Virtual DOM, and how the compiler, server renderer, and hydration walk fit together.">
</wizz:head>

<div class="site">
  <TopNav section="docs" showMenu={true} />
  <div class="doc-shell">
    <Sidebar current="/docs/architecture" />
    <main id="main" class="doc-main glass">
      <article class="prose">
        <header>
          <p class="eyebrow rise" style="--i: 0">Core Concepts</p>
          <h1 class="rise" style="--i: 1">Architecture & Philosophy</h1>
          <p class="lead rise" style="--i: 2">Wizz is a compiler first. Everything a framework usually decides at runtime — which nodes depend on which state, how a list reconciles, which CSS applies to which element — Wizz decides at build time, so the browser runs only the instructions your component actually needs.</p>
        </header>

        <h2 id="philosophy" class="reveal">Philosophy</h2>
        <p>Three convictions shape every design decision:</p>
        <div class="grid-2">
          <div class="mini-card"><h3>The platform is enough</h3><p>Modern browsers ship ES modules, microtasks, BroadcastChannel, and the DOM APIs a UI needs. Wizz targets them directly instead of abstracting over them.</p></div>
          <div class="mini-card"><h3>Constraints are features</h3><p>A small, statically checkable template language lets the compiler prove what changes, and reject what it cannot prove, with a stable diagnostic code.</p></div>
          <div class="mini-card"><h3>Server first, client second</h3><p>Pages render on the server by default. The client adopts that markup rather than rebuilding it, and falls back safely when it cannot.</p></div>
          <div class="mini-card"><h3>Tooling is part of the product</h3><p>A versioned JSON diagnostics envelope and an MCP server make the compiler as legible to CI and AI agents as it is to people.</p></div>
        </div>

        <h3 id="zero-deps" class="reveal">Why zero dependencies</h3>
        <p>Wizz installs without npm. The CLI tarball carries the compiler, runtime, templates, and build tooling, and the generated <code>dist/</code> imports nothing but its own files. That buys you:</p>
        <ul>
          <li><strong>No supply-chain surface</strong> in your app — there is no transitive tree to audit, pin, or patch.</li>
          <li><strong>No version drift</strong> between framework packages, because there is only one artifact.</li>
          <li><strong>Portable output</strong>: a static host serves <code>dist/</code> as-is, and the optional node host uses only Node built-ins.</li>
          <li><strong>Small payloads</strong>: the browser loads the router, the route's compiled modules, and nothing else.</li>
        </ul>

        <h3 id="no-vdom" class="reveal">Why no Virtual DOM</h3>
        <p>A Virtual DOM re-runs your render function and diffs two trees to discover what changed. Wizz already knows: the analyzer records which reactive names every expression reads, so an assignment to <code>count</code> updates exactly the text nodes and attributes that read <code>count</code> — no tree, no diff, no reconciliation pass over static markup.</p>
        <Callout kind="tip" title="The trade-off" body="Because templates are analyzed statically, {...} accepts only identifiers, member access, literals, and strict equality. Anything richer is computed in the script and referenced by name — which also keeps templates easy to read." />

        <h2 id="pipeline" class="reveal">The compiler pipeline</h2>
        <p>Every component passes through the same ordered stages. Callers normally use <code>compile()</code> or <code>compileServer()</code>, which compose them:</p>
        <CodeBlock code={pipelineText} lang="text" title="src/compiler/index.js" />
        <ol>
          <li><strong>Parse</strong> — the tokenizer and Pratt expression parser build a template AST; extractors lift the script, head, and style blocks; the prop extractor and state scanner find <code>export let</code> and <code>let</code> declarations and <code>persist()</code> markers.</li>
          <li><strong>Analyze</strong> — the dependency analyzer maps each template expression to the reactive identifiers it reads; the ID assigner gives every dynamic node a stable <code>data-wizz-id</code>.</li>
          <li><strong>Generate</strong> — the code builder emits a client module, and on request a DOM-free server module and a hydratable client build. The assignment interceptor rewrites statement-level mutations so they notify the scheduler.</li>
        </ol>

        <h2 id="compiled-output" class="reveal">What the compiler emits</h2>
        <p>Take the smallest interesting component:</p>
        <CodeBlock code={counterSource} lang="wizz" title="Counter.wizz" />
        <p>The client module is an ordinary ES module whose default export mounts it. Simplified, it has this shape:</p>
        <CodeBlock code={emittedSketch} lang="js" title="dist/components/Counter.js (simplified)" />
        <p>The real output also wires child components, keyed list updaters, head management, and scoped styles — but there is no runtime library behind it. <code>build.js</code> writes a source map for each module with an author script, so breakpoints land on your original <code>.wizz</code> lines.</p>

        <h2 id="update-model" class="reveal">The update model</h2>
        <ul>
          <li><strong>Marking</strong>: an intercepted assignment marks its variable as changed.</li>
          <li><strong>Batching</strong>: marks combine until the next microtask, so a handler that changes five variables triggers one update.</li>
          <li><strong>Targeted writes</strong>: the update function checks each mark and touches only the nodes that read it — <code>value</code>, <code>checked</code>, and <code>disabled</code> as DOM properties, everything else as attributes.</li>
          <li><strong>Lists</strong>: keyed <code>{"{#each}"}</code> blocks retain, move, create, and remove nodes by key; keyless blocks reconcile by index.</li>
          <li><strong>Children</strong>: parents push new prop values through the child's <code>setProps()</code>; a child is never remounted for a prop change.</li>
        </ul>

        <h2 id="ssr-hydration" class="reveal">SSR & hydration</h2>
        <p>Server rendering is an explicit compile target. For every file whose whole component tree is renderable, the build emits three modules: <code>Name.js</code> (client), <code>Name.server.js</code> (DOM-free renderer), and <code>Name.hydrate.js</code> (adopts server markup).</p>
        <CodeBlock code={ssrRecipe} lang="js" title="application-owned delivery" />
        <ol>
          <li><code>wizz dev</code> and the node adapter match the URL against the route manifest and call <code>renderComponent()</code> per request.</li>
          <li>The router finds the <code>application/wizz-state</code> script beside <code>#app</code>, imports the hydratable build, and calls <code>hydrateComponent()</code>.</li>
          <li>The hydration walk verifies tags, <code>data-wizz-id</code>s, and text against the template, then attaches listeners. Child components are adopted in place through <code>hydrateRoot()</code>.</li>
          <li>On any mismatch it logs one <code>[wizz] hydration mismatch</code> warning, clears the target, and mounts fresh — never a duplicate DOM.</li>
        </ol>
        <Callout kind="warn" title="Keep the first render deterministic" body="Read window, document, localStorage, or the URL inside onMount — never at the top level of a script. The server has no browser globals, and a value that differs between server and client forces a client re-render." />

        <h2 id="styles" class="reveal">Scoped CSS delivery</h2>
        <p>Each <code>{"<wizz:style>"}</code> block is scoped by a generated <code>data-wizz-s</code> attribute on the selector's terminal element, and its <code>@keyframes</code> names gain the same suffix. Delivery never duplicates: <code>wizz dev</code> server-renders one style tag per styled component, hydration adopts it, and client mounts share a refcounted stylesheet. <code>wizz build</code> extracts every scoped rule into <code>dist/app.css</code> and links it from the shell, so production pages are styled from the first paint.</p>

        <h2 id="versioning" class="reveal">Versioning contract</h2>
        <p>Wizz versions three things independently, all defined in <code>src/compiler/version.js</code> and stamped on the first line of every generated module:</p>
        <CodeBlock code={versionLine} lang="js" title="dist/App.js:1" />
        <div class="table-scroll">
          <table>
            <thead><tr><th>Version</th><th>Covers</th><th>Guarantee</th></tr></thead>
            <tbody>
              <tr><td><code>compiler</code></td><td>The compiler itself</td><td>Semver for the tool</td></tr>
              <tr><td><code>syntax</code></td><td>Directives, expression grammar, script boundary</td><td>Within a major, every component that compiled keeps compiling with the same meaning</td></tr>
              <tr><td><code>output</code></td><td>Generated module surface: <code>mountComponent</code>, <code>{"{ setProps?, destroy() }"}</code>, hydration and server exports</td><td>Within a major, modules keep their surface and behavior</td></tr>
            </tbody>
          </table>
        </div>

        <h2 id="security" class="reveal">Security boundaries</h2>
        <ul>
          <li><strong>Components are trusted code.</strong> Wizz is not a sandbox; never compile user-submitted <code>.wizz</code> source.</li>
          <li><strong>Client text</strong> is created with <code>createTextNode()</code>; static values are serialized into the module rather than parsed as HTML.</li>
          <li><strong>Server output</strong> escapes every text and attribute value, and the state script escapes every <code>{"<"}</code> so state cannot close the tag early.</li>
          <li><strong>Hydration</strong> never uses <code>innerHTML</code> or <code>eval</code> — adoption is a read-only DOM walk.</li>
          <li><strong>URLs</strong> in dynamic <code>href</code>/<code>src</code> attributes need application-level validation when they come from untrusted data.</li>
          <li><strong>Source maps</strong> embed the original component source; keep <code>.map</code> files private if that matters.</li>
        </ul>
      </article>
      <PageNav prevHref="/docs/getting-started" prevLabel="Installation & Setup" nextHref="/docs/components" nextLabel="Components & Templating" />
    </main>
    <Toc items={toc} />
  </div>
</div>
