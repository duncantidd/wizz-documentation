<script>
  import TopNav from "../../components/TopNav.wizz";
  import Sidebar from "../../components/Sidebar.wizz";
  import Toc from "../../components/Toc.wizz";
  import CodeBlock from "../../components/CodeBlock.wizz";
  import Callout from "../../components/Callout.wizz";
  import PageNav from "../../components/PageNav.wizz";
  import Counter from "../../components/Counter.wizz";
  import TodoDemo from "../../components/TodoDemo.wizz";

  const toc = [
    { id: "state", label: "Reactive state" },
    { id: "batching", label: "Microtask batching" },
    { id: "mutations", label: "Which mutations are tracked" },
    { id: "arrays", label: "Arrays and objects" },
    { id: "events", label: "Event handling" },
    { id: "bindings", label: "Two-way bindings" },
    { id: "lists", label: "Lists with {#each}" },
    { id: "todo-demo", label: "Live: keyed todo list", depth: 3 },
    { id: "conditionals", label: "Conditional rendering" },
    { id: "persist", label: "persist(): cross-tab state" },
    { id: "persist-demo", label: "Live: persisted counter", depth: 3 },
    { id: "patterns", label: "Patterns" }
  ];

  const stateSource = `<script>
  let count = 0;                  // reactive
  let user = { name: "Ada" };     // reactive
  const LIMIT = 10;               // constant: renders once

  function increment() {
    if (count < LIMIT) {
      count += 1;                 // marks count, schedules one update
    }
  }

  function rename(next) {
    user = { ...user, name: next };   // reassign objects immutably
  }
<\/script>

<main>
  <p>{user.name} clicked {count} times</p>
  <button on:click={increment}>+1</button>
</main>`;

  const batchSource = `function reset() {
  count = 0;           // mark count
  label = "Reset";     // mark label
  history = [];        // mark history
  // nothing has touched the DOM yet...
}
// ...one update runs on the next microtask with all three marks combined.

async function afterReset() {
  reset();
  await Promise.resolve();   // let the microtask flush
  // the DOM now reflects every change
}`;

  const mutationSource = `// Tracked: statement-level assignments and updates, also inside callbacks
count = count + 1;
count += 1;
count++;
user.name = "Grace";              // property chains mark the root (user)
items[0] = first;                 // element writes mark the root too
items = [...items, next];
items.push(next); items = items;  // mutate, then assign: the assignment is the trigger
setTimeout(() => { status = "done"; }, 500);
onMount(() => { ready = true; });

// Not tracked: method calls with no assignment, expression positions, unbraced bodies
items.push(next);                 // warning WIZZ-G027 (1.26.0+): assign afterwards
log(count = 5);                   // warning WIZZ-G026: inside a call argument
if (done) status = "ok";          // warning WIZZ-G026: add braces

// Inline on: handlers follow the same rules
// on:input={(e) => name = e.target.value}      tracked
// on:input={(e) => (name = e.target.value)}    tracked (1.23.0+)
// on:click={() => ok ? a = 1 : 0}              warning WIZZ-G026`;

  const arraySource = `<script>
  let items = [];

  function addCopy(x) {
    items = [...items, x];      // assign a new array
  }

  function addInPlace(x) {
    items.push(x);
    items = items;              // mutate, then assign the same array
  }

  function forgot(x) {
    items.push(x);              // warning WIZZ-G027: nothing re-renders
  }
<\/script>

<p>{items.length} items</p>`;

  const arrayWarning = `Warning WIZZ-G027: 'items' is changed in place by .push() and never reassigned
afterwards, so the DOM will not update at src/Cart.wizz:14:5. Reassign it after the call
(\`items.push(x); items = items;\`) or assign a new array instead (\`items = [...items, x]\`);
assignment is what schedules the update.`;

  const eventSource = `<script>
  let query = "";
  let name = "";
  let count = 0;

  function handleInput(event) {
    query = event.target.value;
  }

  function add(amount) {
    count += amount;
  }

  function handleSubmit(event) {
    event.preventDefault();
  }
<\/script>

<form on:submit={handleSubmit}>
  <input value={query} on:input={handleInput} />
  <input value={name} on:input={(event) => name = event.target.value} />
  <button type="button" on:click={(event) => add(5)}>+5</button>
</form>`;

  const listSource = `<script>
  let todos = [
    { id: 1, title: "Read the contract", rowClass: "item is-done" },
    { id: 2, title: "Build a keyed list", rowClass: "item" }
  ];

  function removeTodo(id) {
    todos = todos.filter((todo) => todo.id !== id);
  }
<\/script>

<div class="todos">
  <ul>{#each todos as todo (todo.id)}<li class={todo.rowClass}><span>{todo.title}</span><button type="button" on:click={() => removeTodo(todo.id)}>×</button></li>{/each}</ul>
</div>`;

  const keylessSource = `<script>
  let tags = ["compiler", "ssr", "zero-deps"];
<\/script>

<ul class="tags">{#each tags as tag}<li>{tag}</li>{/each}</ul>`;

  const ifSource = `<script>
  let open = false;
  let error = "";

  function toggle() {
    open = !open;
  }
<\/script>

<div class="panel">
  <button type="button" on:click={toggle}>Toggle details</button>
  {#if open}
    <p>Shown while open is truthy; removed from the DOM when false.</p>
  {:else}
    <p>Collapsed.</p>
  {/if}
  {#if error}
    <p class="error">{error}</p>
  {/if}
</div>`;

  const toggleSource = `<script>
  let open = false;

  function toggle() {
    open = !open;
  }
<\/script>

<section class="disclosure">
  <button on:click={toggle} aria-expanded={open}>Details</button>
  <div class="panel" hidden={!open}>Kept in the DOM while hidden, preserving internal state.</div>
</section>`;

  const bindSource = `<script>
  let food = "";
  let calories = 0;
  let logged = false;
  let meal = "lunch";
<\/script>

<form class="food">
  <input bind:value={food} placeholder="Food" />
  <input type="number" bind:value={calories} />
  <label><input type="checkbox" bind:checked={logged} /> Logged</label>
  <select bind:value={meal}>
    <option value="lunch">Lunch</option>
    <option value="dinner">Dinner</option>
  </select>
  <p>{food === "" ? "Nothing yet" : food + ": " + calories + " kcal"}{logged ? " (logged)" : ""}</p>
</form>`;

  const persistSource = `<script>
  let theme = persist("theme", "light");

  function toggle() {
    theme = theme === "light" ? "dark" : "light";
  }
<\/script>

<main>
  <button on:click={toggle}>Theme: {theme}</button>
</main>`;

  const derivedSource = `<script>
  let items = [];
  let total = 0;

  // One function owns every derived value; call it after each change.
  function recompute() {
    total = items.reduce((sum, item) => sum + item.price, 0);
  }

  function add(item) {
    items = [...items, item];
    recompute();
  }

  onMount(recompute);   // also after hydration restores persisted state
<\/script>

<!-- A value one expression can say needs no let at all (1.23.0+). -->
<p>{items.length === 0 ? "Cart is empty" : items.length + " items"} · {total}</p>`;
</script>

<wizz:head>
  <title>State & Reactivity — Wizz.js Docs</title>
  <meta name="description" content="Reactive let state, microtask batching, events, keyed lists, conditionals, and persist() cross-tab state in Wizz.js.">
</wizz:head>

<div class="site">
  <TopNav section="docs" showMenu={true} />
  <div class="doc-shell">
    <Sidebar current="/docs/reactivity" />
    <main id="main" class="doc-main glass">
      <article class="prose">
        <header>
          <p class="eyebrow rise" style="--i: 0">Core Concepts</p>
          <h1 class="rise" style="--i: 1">State & Reactivity</h1>
          <p class="lead rise" style="--i: 2">Reactivity in Wizz is plain JavaScript: declare state with <code>let</code>, change it with assignment. The compiler finds the assignments, the analyzer knows which nodes read each variable, and a microtask scheduler applies the changes in one pass.</p>
        </header>

        <h2 id="state" class="reveal">Reactive state</h2>
        <p>Every top-level <code>let</code> in a component script is reactive. Reassigning it marks the variable as changed and schedules an update. <code>const</code> bindings render once.</p>
        <CodeBlock code={stateSource} lang="wizz" title="Counter.wizz" />

        <h2 id="batching" class="reveal">Microtask batching</h2>
        <p>Updates are <strong>asynchronous and batched</strong>. Each assignment only marks its variable; one DOM update runs on the next microtask with every mark combined. A handler that changes several variables triggers a single update, and the DOM settles before the browser paints.</p>
        <CodeBlock code={batchSource} lang="js" title="batching" />
        <Callout kind="note" title="Testing tip" body="Read the DOM after an await (for example await Promise.resolve()), not synchronously after dispatching an event — the update has not run yet." />

        <h2 id="mutations" class="reveal">Which mutations are tracked</h2>
        <p>A syntax-aware rewriter inserts the scheduler call after <strong>statement-level</strong> mutations, following them into function and arrow callback bodies. Mutations in expression positions are deliberately left alone, because rewriting inside an expression could change what it means.</p>
        <CodeBlock code={mutationSource} lang="js" title="tracked vs. untracked" />
        <p>From 1.23.0 the compiler reports every assignment it leaves untracked as warning <code>WIZZ-G026</code>, in the script and in inline handlers, located at the line and column. Warnings never fail a build: <code>wizz build</code> and <code>wizz dev</code> print them, <code>--json</code> lists them in <code>diagnostics</code> with <code>"severity": "warning"</code> while <code>ok</code> stays true, and the MCP diagnostics tools return them. Parameter defaults, declarations, class fields, and names shadowed by a parameter or a local <code>let</code> are not reported.</p>

        <h2 id="arrays" class="reveal">Arrays and objects</h2>
        <p><strong>Assignment is the trigger.</strong> Every statement-level assignment to a reactive <code>let</code> schedules an update, and Wizz never checks whether the value or reference actually changed. That gives two equally supported ways to change an array:</p>
        <CodeBlock code={arraySource} lang="wizz" title="Cart.wizz" />
        <ul>
          <li><code>{"items = items"}</code> is not a no-op: the assignment, not a new reference, tells Wizz to re-render. A bare <code>items.push(x)</code> with nothing assigned afterwards changes the array and schedules nothing.</li>
          <li>Writes through a member count too and mark the root name: <code>{'user.name = "Ada";'}</code>, <code>{'items[0] = "first";'}</code>, and <code>{"items.length = 0;"}</code> each re-render whatever reads <code>user</code> or <code>items</code>.</li>
          <li>When a list re-renders, keyed and keyless <code>{"{#each}"}</code> blocks run every row's update, so an item object changed in place (<code>{'rows[1].name = "Cy"; rows = rows;'}</code>) shows its new values without its row being rebuilt.</li>
          <li>There is no deep reactivity (no proxies) and array methods are not instrumented: assignment stays the single trigger, which keeps generated code small and predictable. Props are separate: a parent passing the same reference again is skipped by an <code>Object.is</code> check, and props are read-only in the child.</li>
        </ul>
        <p>From 1.26.0 the compiler warns about the forgotten half as <code>WIZZ-G027</code>, through the same channels as <code>WIZZ-G026</code>, located at the call:</p>
        <CodeBlock code={arrayWarning} lang="text" title="wizz build" />
        <p>It fires for <code>push</code>, <code>pop</code>, <code>shift</code>, <code>unshift</code>, <code>splice</code>, <code>sort</code>, <code>reverse</code>, <code>fill</code>, and <code>copyWithin</code> called as a statement of its own inside a function or inline <code>on:</code> handler, when nothing assigns or member-writes that name later in the outermost enclosing function. A later assignment inside a nested callback counts, so <code>{"items.push(x); setTimeout(() => { items = items; });"}</code> is quiet.</p>
        <Callout kind="note" title="What G027 does not catch" body={"The check is syntactic and conservative. It does not follow aliases (const a = items; a.push(x)), computed names (items['push'](x)), calls in expression position or an unbraced if body on the same line, or Map and Set methods. Props are excluded because they are read-only. Calls at the top level of the script run before the first render, so they are never reported."} />

        <h2 id="events" class="reveal">Event handling</h2>
        <p><code>{"on:<event>"}</code> binds any native DOM event name — <code>click</code>, <code>input</code>, <code>submit</code>, <code>keydown</code>, <code>pointermove</code> — with <code>addEventListener</code>. The value is either a component function or an expression that receives the event.</p>
        <CodeBlock code={eventSource} lang="wizz" title="Search.wizz" />
        <ul>
          <li>Event directives work on <strong>native elements only</strong> — pass callbacks to components as props.</li>
          <li>Handlers are client-only; server rendering skips them, and hydration attaches them after the adoption walk passes.</li>
          <li><code>destroy()</code> removes every listener Wizz attached.</li>
          <li>Assignments inside an inline arrow or <code>function</code> handler are tracked like assignments in script functions, with or without parentheses around the body: <code>{"on:input={(e) => (name = e.target.value)}"}</code> updates the DOM (1.23.0+; earlier releases tracked only the unparenthesized form). An inline handler that assigns a prop fails with <code>WIZZ-G015</code>.</li>
        </ul>
        <Callout kind="note" title="Upgrading from an earlier release" body="Before 1.17.1, an assignment written directly in an inline handler changed the variable but never updated the DOM. If wizz --version reports an older compiler, run wizz update." />
        <Callout kind="tip" title="Prefer named handlers" body="Inline arrows are reactive, but named functions keep templates scannable and are easy to unit-test." />

        <h2 id="bindings" class="reveal">Two-way bindings</h2>
        <p>From 1.23.0, <code>bind:value</code> and <code>bind:checked</code> keep a form control and a top-level <code>let</code> in sync in both directions: typing updates the variable, and assigning the variable updates the control.</p>
        <CodeBlock code={bindSource} lang="wizz" title="FoodForm.wizz" />
        <ul>
          <li><strong>It is shorthand for the pair you would write.</strong> <code>{"bind:value={food}"}</code> compiles to <code>{"value={food}"}</code> plus an <code>on:input</code> handler that assigns <code>food</code> (<code>on:change</code> for <code>{"<select>"}</code> and checkboxes), so it server-renders the current value, hydrates, works inside <code>{"{#if}"}</code> branches, and writes <code>persist()</code> state through to storage.</li>
          <li><code>bind:value</code> works on <code>{"<input>"}</code> (any type except <code>checkbox</code>, <code>radio</code>, and <code>file</code>), <code>{"<textarea>"}</code>, and <code>{"<select>"}</code>; <code>bind:checked</code> works on <code>{'<input type="checkbox">'}</code>.</li>
          <li><code>type="number"</code> and <code>type="range"</code> bind numbers, and an empty field binds <code>null</code>. A half-typed number such as <code>1.</code> is left alone rather than overwritten. A bound <code>{"<input>"}</code> needs a static <code>type</code>.</li>
          <li>The target must be a top-level <code>let</code> named directly. Props are read-only, so copy one into a local <code>let</code> to bind it.</li>
          <li>An <code>on:input</code> handler of your own can sit beside a binding; both run.</li>
        </ul>
        <Callout kind="warn" title="Where bindings are not available" body={"Bindings are rejected on imported component tags, inside {#each} bodies (a row re-renders only when its collection changes, so the control would not follow the state), and for bind:group, bind:this, and other properties: WIZZ-P062 to WIZZ-P064, never a silent no-op. Use value={...} with an on:input handler there, for example on:input={(e) => rename(todo.id, e.target.value)} in a row."} />
        <Callout kind="note" title="Server-rendered textarea and select" body="The server writes value as an attribute, which <textarea> and <select> do not display, so they show their bound value once the page hydrates. Inputs show it immediately." />

        <h2 id="lists" class="reveal">Lists with {"{#each}"}</h2>
        <p>Give each row a key when node identity should follow the item — for example when rows reorder. When the collection is assigned (a new array, or <code>{"items = items"}</code> after changing it in place; see <a href="#arrays">Arrays and objects</a>), Wizz retains matching keys, moves them into the new order, updates their text and attributes, creates new keys, and removes missing ones. Duplicate keys throw. Elements inside the row body may use <code>on:</code> directives with the item variable in scope (1.22.0+): when a retained key receives a new item object, its handlers automatically read the replacement, and removed rows release their listeners.</p>
        <CodeBlock code={listSource} lang="wizz" title="Todos.wizz" />
        <p>For primitives, or when position is identity enough, omit the key. A keyless block updates rows in place by index, appends as it grows, and trims as it shrinks.</p>
        <CodeBlock code={keylessSource} lang="wizz" title="Tags.wizz" />
        <div class="grid-2">
          <div class="mini-card"><h3>Every {"{#each}"} must…</h3><p>sit inside a native element, have exactly one native root element per row, and iterate a reactive <code>let</code> to update (a <code>const</code> renders once).</p></div>
          <div class="mini-card"><h3>Row bodies may not contain…</h3><p>imported components (<code>WIZZ-G004</code>) or nested {"{#if}"}/{"{#each}"} blocks (<code>WIZZ-G005</code>). Precompute per-row classes and labels in the script.</p></div>
        </div>
        <Callout kind="note" title="Inline arrow vs. factory call on rows" body={"An each item's on: expression is evaluated once when the row is created. Write on:click={() => removeTodo(todo.id)} rather than on:click={makeHandler(todo)} so the handler reads the latest item value on click. Before 1.22.0, on: inside {#each} failed with WIZZ-G006; delegate from the parent container on older compilers."} />

        <h3 id="todo-demo" class="reveal">Live: keyed todo list</h3>
        <p>A keyed list with one delegated click listener, a submit handler, CSS-driven filtering, and <code>persist()</code> — add a few items and reload.</p>
        <div class="sandbox">
          <p class="sandbox-label">Live · TodoDemo.wizz</p>
          <TodoDemo />
        </div>

        <h2 id="conditionals" class="reveal">Conditional rendering</h2>
        <p><code>{"{#if}"}</code> chooses a branch with the full expression grammar — <code>{"{#if items.length > 0 && !busy}"}</code> is valid from 1.23.0 — plus an optional <code>{"{:else}"}</code>. From 1.22.0, whenever a reactive <code>let</code> or prop read by the test changes, Wizz re-evaluates the condition and swaps the branch in place if its truthiness changed: the old branch's DOM nodes, <code>on:</code> listeners, inner lists, and child components are torn down, and the new branch is built from current state. A test that reads only <code>const</code> bindings renders once at mount with no block overhead.</p>
        <CodeBlock code={ifSource} lang="wizz" title="Panel.wizz" />
        <Callout kind="tip" title="Preserving DOM state while hidden" body={"Swapping an {#if} branch destroys the old branch and builds a fresh one, so typed input text, scroll position, or a child component's internal state inside that branch is reset. When an element should stay mounted while hidden, toggle hidden={!open} or a bound class instead."} />
        <CodeBlock code={toggleSource} lang="wizz" title="Disclosure.wizz" />
        <Callout kind="note" title="Upgrading from an earlier release" body="Before 1.22.0, {#if} chose its branch once at mount and never swapped it when state changed (and before 1.18.1, a reactive binding inside an untaken branch crashed the mount). If wizz --version reports an older compiler, run wizz update." />

        <h2 id="persist" class="reveal">persist(): cross-tab state</h2>
        <p>Initialize a top-level <code>let</code> with <code>persist(key, default)</code> and it survives reloads and stays in sync across tabs, with no other change to how you use it.</p>
        <CodeBlock code={persistSource} lang="wizz" title="ThemeToggle.wizz" />
        <ul>
          <li><strong>Mount</strong>: the stored value (JSON) wins over the default; unreadable values fall back to the default.</li>
          <li><strong>Write</strong>: every statement mutation writes back. Quota and private-mode failures leave in-memory state intact.</li>
          <li><strong>Sync</strong>: mounts subscribe to a shared per-page bus; tabs converge over <code>BroadcastChannel</code>, falling back to <code>storage</code> events. A tab's own writes never echo back.</li>
          <li><strong>Server</strong>: there is no storage, so SSR renders the default and hydration restores the stored value — derive dependent values in <code>onMount</code>.</li>
          <li><strong>Keys</strong> are string literals used verbatim: two components persisting the same key share state on purpose.</li>
        </ul>
        <Callout kind="note" title="Compile-time checks" body="persist() must initialize a top-level let with exactly two arguments and a string-literal key. Using it on a prop, a const, nested in a function, or inside another persist() fails with WIZZ-P044 to WIZZ-P052." />

        <h3 id="persist-demo" class="reveal">Live: persisted counter</h3>
        <p>This is the same <code>wizz_docs_counter</code> key as the landing page hero. Change it here, then open the home page in another tab.</p>
        <div class="sandbox">
          <p class="sandbox-label">Live · Counter.wizz</p>
          <Counter label="Shared with the hero" />
        </div>

        <h2 id="patterns" class="reveal">Patterns</h2>
        <h3>Derived values</h3>
        <p>A derived value that one expression can say belongs in the template (1.23.0+): conditionals, comparisons, and calls cover labels, classes, and counts with no extra state. Wizz has no computed-value declaration, so for anything that needs a loop or an arrow, such as a <code>reduce</code>, keep a single function that recomputes it, call it after the mutations that matter, and once on mount.</p>
        <CodeBlock code={derivedSource} lang="wizz" title="Cart.wizz" />
        <h3>Cleanup</h3>
        <p>Anything you start in <code>onMount</code> — intervals, observers, global listeners, <code>AbortController</code>s — stop in <code>onDestroy</code>. Do not change state there; the component is being torn down.</p>
      </article>
      <PageNav prevHref="/docs/components" prevLabel="Components & Templating" nextHref="/docs/routing" nextLabel="Routing & Navigation" />
    </main>
    <Toc items={toc} />
  </div>
</div>
